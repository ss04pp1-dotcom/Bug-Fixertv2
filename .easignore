# ─── node_modules (সব level এ) ──────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build / cache output ────────────────────────────────────────────────────
dist/
build/
out/
.next/
web-build/
.expo/
.expo-shared/
android/
ios/

# ─── Monorepo packages not needed for mobile build ───────────────────────────
# (source kept for pnpm workspace resolution, only heavy build artifacts removed)
artifacts/admin/.next/
artifacts/admin/dist/
artifacts/admin/build/
artifacts/api-server/dist/
artifacts/api-server/build/
lib/*/dist/
lib/*/build/

# ─── Git ─────────────────────────────────────────────────────────────────────
.git/

# ─── Replit-specific ─────────────────────────────────────────────────────────
.local/
.replit
replit.nix
attached_assets/
tools/

# ─── Test & coverage ─────────────────────────────────────────────────────────
coverage/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__/
**/__mocks__/

# ─── IDE & OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
**/*.log

# ─── Prisma generated (re-generated on build server) ─────────────────────────
artifacts/api-server/node_modules/.prisma/
