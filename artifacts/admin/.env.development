# StreamPro Admin Panel — Development Environment
# By default points at the live Render API so the admin works without needing
# the local API server running. To test against the local API instead, create
# a .env.local file (gitignored) and override NEXT_PUBLIC_API_URL there:
#
#   NEXT_PUBLIC_API_URL=https://<your-replit-dev-domain>/api-server
#   NEXT_PUBLIC_WS_URL=wss://<your-replit-dev-domain>/api-server

NEXT_PUBLIC_API_URL=https://bug-fixertv2.onrender.com
NEXT_PUBLIC_WS_URL=wss://bug-fixertv2.onrender.com
NEXT_PUBLIC_IMAGE_URL=
NEXT_PUBLIC_CDN_URL=
