# ─────────────────────────────────────────────────────────────────────────────
# StreamPro Admin Panel — Environment Variables
# Copy to .env.local for local development.
# Set these in Cloudflare Pages → Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Server URL ────────────────────────────────────────────────────────────
# Production (Cloudflare Pages): point to your Render API URL
# Development: leave empty — Next.js proxy handles routing automatically
NEXT_PUBLIC_API_URL=https://streampro-api.onrender.com

# ── Optional: override the Next.js base path (default: /admin) ───────────────
# NEXT_PUBLIC_BASE_PATH=/admin
