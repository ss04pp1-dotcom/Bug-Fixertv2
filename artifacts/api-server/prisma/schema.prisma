generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  super_admin
  admin
  moderator
  editor
  support
  user

  @@map("user_role")
}

enum StreamType {
  HLS
  M3U
  RTMP
  DASH

  @@map("stream_type")
}

enum SubscriptionStatus {
  inactive
  active
  expired
  cancelled
  trial
  pending
  refunded

  @@map("subscription_status")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded

  @@map("payment_status")
}

enum NotificationType {
  push
  in_app
  email
  sms

  @@map("notification_type")
}

enum AdType {
  banner
  video
  popup
  interstitial
  rewarded
  native
  app_open
  splash

  @@map("ad_type")
}

enum AdEventType {
  impression
  click
  error
  session
  revenue

  @@map("ad_event_type")
}

enum CouponDiscountType {
  percentage
  fixed

  @@map("coupon_discount_type")
}

enum AuditLevel {
  info
  warning
  critical

  @@map("audit_level")
}

enum ChannelStreamStatus {
  pending
  checking
  active
  offline
  failed

  @@map("channel_stream_status")
}

enum HealthOverride {
  AUTO
  FORCE_HEALTHY
  FORCE_OFFLINE

  @@map("health_override")
}

enum HealthCheckMode {
  SERVER
  USER_PLAYBACK
  DISABLED

  @@map("health_check_mode")
}

enum ServerSourceType {
  ADMIN
  GITHUB

  @@map("server_source_type")
}

enum GitHubSyncStatus {
  pending
  running
  success
  failed

  @@map("github_sync_status")
}

enum ImportJobStatus {
  pending
  parsing
  validating
  completing
  completed
  failed
  cancelled

  @@map("import_job_status")
}

enum ImportChannelStatus {
  pending
  checking
  active
  failed
  skipped

  @@map("import_channel_status")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  email              String?   @unique
  phone              String?   @unique
  passwordHash       String?   @map("password_hash")
  avatar             String?
  role               UserRole  @default(user)
  isActive           Boolean   @default(true) @map("is_active")
  emailVerified      Boolean   @default(false) @map("email_verified")
  phoneVerified      Boolean   @default(false) @map("phone_verified")
  isPremium          Boolean   @default(false) @map("is_premium")
  subscriptionEndsAt DateTime? @map("subscription_ends_at")
  country            String?
  language           String?   @default("en")
  fcmToken           String?   @map("fcm_token")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  sessions              Session[]
  otps                  Otp[]
  favorites             Favorite[]
  watchHistory          WatchHistory[]
  searchHistory         SearchHistory[]
  subscription          Subscription?
  auditLogs             AuditLog[]
  parentalSetting       ParentalSetting?
  payments              Payment[]
  matchAlerts           MatchAlert[]
  favoriteTeams         UserFavoriteTeam[]
  downloads             Download[]
  reviews               Review[]
  notificationReads     NotificationRead[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token")
  deviceName   String?  @map("device_name")
  deviceType   String?  @map("device_type")
  platform     String?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  expiresAt    DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Otp {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  identifier String
  code       String
  type       String
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  channels Channel[]
  movies   Movie[]
  series   Series[]

  @@map("categories")
}

model Channel {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  slug             String     @unique
  description      String?
  logo             String?
  thumbnail        String?
  banner           String?
  categoryId       String?    @map("category_id") @db.Uuid
  language         String?
  country          String?
  primaryStreamUrl String?    @map("primary_stream_url")
  backupStreamUrl  String?    @map("backup_stream_url")
  thirdBackupUrl   String?    @map("third_backup_url")
  streamType       StreamType @default(HLS) @map("stream_type")
  epgChannelId     String?    @map("epg_channel_id")
  streamStatus     ChannelStreamStatus @default(active) @map("stream_status")
  healthOverride   HealthOverride @default(AUTO) @map("health_override")
  isActive         Boolean    @default(true) @map("is_active")
  isFeatured       Boolean    @default(false) @map("is_featured")
  isTrending       Boolean    @default(false) @map("is_trending")
  isPremium        Boolean    @default(false) @map("is_premium")
  isLive           Boolean    @default(true) @map("is_live")
  viewCount        Int        @default(0) @map("view_count")
  sortOrder        Int        @default(0) @map("sort_order")
  tags             String[]
  lastActiveAt     DateTime?  @map("last_active_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  // GitHub dedup & admin overrides
  normalizedName          String?    @map("normalized_name")
  githubChannelId         String?    @map("github_channel_id")
  adminNameOverride       String?    @map("admin_name_override")
  adminLogoOverride       String?    @map("admin_logo_override")
  adminCategoryIdOverride String?    @map("admin_category_id_override") @db.Uuid

  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  epgPrograms     EpgProgram[]
  favorites       Favorite[]
  playbackEvents  PlaybackEvent[]
  servers         ChannelServer[]

  @@index([isActive])
  @@index([categoryId])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@unique([normalizedName])
  @@map("channels")
}

// ─── GitHub Sources & Channel Servers ───────────────────────────────────────

model GitHubSource {
  id                   String            @id @default(uuid()) @db.Uuid
  name                 String
  url                  String
  enabled              Boolean           @default(true)
  syncIntervalMinutes  Int               @default(10) @map("sync_interval_minutes")
  etag                 String?
  lastModified         String?           @map("last_modified")
  lastFetchedAt        DateTime?         @map("last_fetched_at")
  lastSyncAt           DateTime?         @map("last_sync_at")
  lastSuccessfulSyncAt DateTime?         @map("last_successful_sync_at")
  lastSyncStatus       GitHubSyncStatus? @map("last_sync_status")
  lastSyncMessage      String?           @map("last_sync_message")
  consecutiveFailures  Int               @default(0) @map("consecutive_failures")
  isSyncing            Boolean           @default(false) @map("is_syncing")
  syncStartedAt        DateTime?         @map("sync_started_at")
  channelCount         Int               @default(0) @map("channel_count")
  serverCount          Int               @default(0) @map("server_count")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  servers  ChannelServer[]
  syncLogs GitHubSyncLog[]

  @@index([enabled])
  @@map("github_sources")
}

model ChannelServer {
  id                 String           @id @default(uuid()) @db.Uuid
  channelId          String           @map("channel_id") @db.Uuid
  link               String
  cookie             String?
  userAgent          String?          @map("user_agent")
  referer            String?
  origin             String?
  priority           Int              @default(100)
  sourceType         ServerSourceType @default(ADMIN) @map("source_type")
  githubSourceId     String?          @map("github_source_id") @db.Uuid
  githubChannelId    String?          @map("github_channel_id")
  enabled            Boolean          @default(true)
  healthCheckEnabled Boolean          @default(true) @map("health_check_enabled")
  lastSeenAt         DateTime?        @map("last_seen_at")
  createdBySync      Boolean          @default(false) @map("created_by_sync")
  deletedAt          DateTime?        @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  githubSource GitHubSource? @relation(fields: [githubSourceId], references: [id], onDelete: SetNull)

  @@index([channelId])
  @@index([githubSourceId])
  @@index([sourceType])
  @@index([deletedAt])
  @@map("channel_servers")
}

model GitHubSyncLog {
  id             String           @id @default(uuid()) @db.Uuid
  githubSourceId String           @map("github_source_id") @db.Uuid
  startedAt      DateTime         @map("started_at")
  endedAt        DateTime?        @map("ended_at")
  durationMs     Int?             @map("duration_ms")
  status         GitHubSyncStatus
  added          Int              @default(0)
  updated        Int              @default(0)
  deleted        Int              @default(0)
  failed         Int              @default(0)
  totalParsed    Int              @default(0) @map("total_parsed")
  errorMessage   String?          @map("error_message")
  createdAt      DateTime         @default(now()) @map("created_at")

  githubSource GitHubSource @relation(fields: [githubSourceId], references: [id], onDelete: Cascade)

  @@index([githubSourceId])
  @@index([createdAt])
  @@map("github_sync_logs")
}

model PlaybackEvent {
  id         String   @id @default(uuid()) @db.Uuid
  channelId  String   @map("channel_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  success    Boolean
  duration   Int?
  appVersion String?  @map("app_version")
  createdAt  DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([createdAt])
  @@map("playback_events")
}

model DeletedChannelLog {
  id           String   @id @default(uuid()) @db.Uuid
  channelName  String   @map("channel_name")
  streamUrl    String?  @map("stream_url")
  logo         String?
  categoryName String?  @map("category_name")
  deleteReason String   @map("delete_reason")
  deletedAt    DateTime @default(now()) @map("deleted_at")

  @@index([deletedAt])
  @@map("deleted_channel_logs")
}

model Movie {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  slug        String    @unique
  description String?
  poster      String?
  banner      String?
  trailerUrl  String?   @map("trailer_url")
  streamUrl   String?   @map("stream_url")
  categoryId  String?   @map("category_id") @db.Uuid
  genres      String[]
  cast        String[]
  director    String?
  year        Int?
  duration    Int?
  rating      Float?
  ageRating   String?   @map("age_rating")
  language    String?
  country     String?
  isPremium   Boolean   @default(false) @map("is_premium")
  isFeatured  Boolean   @default(false) @map("is_featured")
  isTrending  Boolean   @default(false) @map("is_trending")
  isActive    Boolean   @default(true) @map("is_active")
  viewCount   Int       @default(0) @map("view_count")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  favorites    Favorite[]
  watchHistory WatchHistory[]

  @@index([isActive])
  @@index([categoryId])
  @@index([createdAt])
  @@map("movies")
}

model Series {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  slug        String    @unique
  description String?
  poster      String?
  banner      String?
  trailerUrl  String?   @map("trailer_url")
  categoryId  String?   @map("category_id") @db.Uuid
  genres      String[]
  cast        String[]
  director    String?
  year        Int?
  ageRating   String?   @map("age_rating")
  language    String?
  country     String?
  isPremium   Boolean   @default(false) @map("is_premium")
  isFeatured  Boolean   @default(false) @map("is_featured")
  isTrending  Boolean   @default(false) @map("is_trending")
  isActive    Boolean   @default(true) @map("is_active")
  viewCount   Int       @default(0) @map("view_count")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seasons      Season[]
  favorites    Favorite[]
  watchHistory WatchHistory[]

  @@index([isActive])
  @@index([categoryId])
  @@index([createdAt])
  @@map("series")
}

model Season {
  id          String   @id @default(uuid()) @db.Uuid
  seriesId    String   @map("series_id") @db.Uuid
  seasonNumber Int     @map("season_number")
  title       String?
  description String?
  poster      String?
  year        Int?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  series   Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([seriesId, seasonNumber])
  @@map("seasons")
}

model Episode {
  id            String    @id @default(uuid()) @db.Uuid
  seasonId      String    @map("season_id") @db.Uuid
  episodeNumber Int       @map("episode_number")
  title         String
  description   String?
  thumbnail     String?
  streamUrl     String?   @map("stream_url")
  duration      Int?
  ageRating     String?   @map("age_rating")
  isPremium     Boolean   @default(false) @map("is_premium")
  isActive      Boolean   @default(true) @map("is_active")
  viewCount     Int       @default(0) @map("view_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  season       Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  @@unique([seasonId, episodeNumber])
  @@map("episodes")
}

model EpgProgram {
  id          String   @id @default(uuid()) @db.Uuid
  channelId   String   @map("channel_id") @db.Uuid
  title       String
  description String?
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  category    String?
  poster      String?
  rating      String?
  isLive      Boolean  @default(false) @map("is_live")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("epg_programs")
}

model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  description  String?
  price        Float
  currency     String   @default("USD")
  durationDays Int      @map("duration_days")
  features     String[]
  isActive     Boolean  @default(true) @map("is_active")
  isFeatured   Boolean  @default(false) @map("is_featured")
  trialDays    Int      @default(0) @map("trial_days")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @map("user_id") @db.Uuid
  planId          String             @map("plan_id") @db.Uuid
  status          SubscriptionStatus @default(active)
  startedAt       DateTime           @default(now()) @map("started_at")
  endsAt          DateTime           @map("ends_at")
  trialEndsAt     DateTime?          @map("trial_ends_at")
  renewedAt       DateTime?          @map("renewed_at")
  nextRenewalAt   DateTime?          @map("next_renewal_at")
  cancelledAt     DateTime?          @map("cancelled_at")
  couponCode      String?            @map("coupon_code")
  discount        Float?
  autoRenew       Boolean            @default(true) @map("auto_renew")
  gracePeriodDays Int                @default(3) @map("grace_period_days")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([status])
  @@index([endsAt])
  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  gateway        String
  gatewayTxId    String?       @map("gateway_tx_id")
  amount         Float
  currency       String        @default("USD")
  status         PaymentStatus @default(pending)
  invoiceNumber  String?       @unique @map("invoice_number")
  refundReason   String?       @map("refund_reason")
  webhookPayload Json?         @map("webhook_payload")
  metadata       Json?
  paidAt         DateTime?     @map("paid_at")
  refundedAt     DateTime?     @map("refunded_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([subscriptionId])
  @@map("payments")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  body        String
  type        NotificationType @default(push)
  targetAll   Boolean          @default(false) @map("target_all")
  targetRoles String[]         @map("target_roles")
  targetUsers String[]         @map("target_users") @db.Uuid
  country     String?
  language    String?
  isPremium   Boolean?         @map("is_premium")
  imageUrl    String?          @map("image_url")
  deepLink    String?          @map("deep_link")
  scheduledAt DateTime?        @map("scheduled_at")
  sentAt      DateTime?        @map("sent_at")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  readReceipts NotificationRead[]

  @@map("notifications")
}

model NotificationRead {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@map("notification_reads")
}

model Announcement {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  message      String
  type         String    @default("banner")
  priority     Int       @default(0)
  imageUrl     String?   @map("image_url")
  deepLink     String?   @map("deep_link")
  isDismissible Boolean  @default(true) @map("is_dismissible")
  targetAll    Boolean   @default(true) @map("target_all")
  country      String?
  language     String?
  isPremium    Boolean?  @map("is_premium")
  startsAt     DateTime? @map("starts_at")
  expiresAt    DateTime? @map("expires_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("announcements")
}

model Advertisement {
  id         String    @id @default(uuid()) @db.Uuid
  title      String
  type       AdType    @default(banner)
  imageUrl   String?   @map("image_url")
  videoUrl   String?   @map("video_url")
  targetUrl  String?   @map("target_url")
  duration   Int?
  providerId String?   @map("provider_id") @db.Uuid
  country    String?
  language   String?
  isPremium  Boolean   @default(false) @map("is_premium")
  isActive   Boolean   @default(true) @map("is_active")
  startDate  DateTime? @map("start_date")
  endDate    DateTime? @map("end_date")
  impressions Int      @default(0)
  clicks     Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  provider AdProvider? @relation(fields: [providerId], references: [id])

  @@map("advertisements")
}

model AdProvider {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  slug               String    @unique
  apiKey             String?   @map("api_key")
  appId              String?   @map("app_id")
  adUnitBanner       String?   @map("ad_unit_banner")
  adUnitInterstitial String?   @map("ad_unit_interstitial")
  adUnitRewarded     String?   @map("ad_unit_rewarded")
  adUnitNative       String?   @map("ad_unit_native")
  adUnitAppOpen      String?   @map("ad_unit_app_open")
  isActive           Boolean   @default(true) @map("is_active")
  isSelected         Boolean   @default(false) @map("is_selected")
  isTestMode         Boolean   @default(true) @map("is_test_mode")
  config             Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  advertisements Advertisement[]
  adEvents       AdEvent[]

  @@map("ad_providers")
}

model AdSetting {
  id                      String   @id @default(uuid()) @db.Uuid
  key                     String   @unique
  activeProviderId        String?  @map("active_provider_id") @db.Uuid
  maxAdsPerSession        Int      @default(5) @map("max_ads_per_session")
  maxAdsPerDay            Int      @default(20) @map("max_ads_per_day")
  cooldownSeconds         Int      @default(30) @map("cooldown_seconds")
  minIntervalSeconds      Int      @default(60) @map("min_interval_seconds")
  interstitialEveryNScreens Int    @default(3) @map("interstitial_every_n_screens")
  interstitialEveryNMinutes Int    @default(5) @map("interstitial_every_n_minutes")
  rewardedCooldownSeconds Int      @default(120) @map("rewarded_cooldown_seconds")
  frequencyCap            Int      @default(10) @map("frequency_cap")
  isEnabled               Boolean  @default(true) @map("is_enabled")
  forceUpdate             Boolean  @default(false) @map("force_update")
  maintenanceMode         Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage      String?  @map("maintenance_message")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("ad_settings")
}

