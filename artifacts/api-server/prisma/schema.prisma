}

enum DownloadStatus {
  pending
  downloading
  completed
  failed
  paused
  cancelled

  @@map("download_status")
}

// ─── Sports Models ──────────────────────────────────────────

model Sport {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  icon        String?
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tournaments Tournament[]
  matches     Match[]

  @@index([isActive])
  @@map("sports")
}

model Tournament {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  logo        String?
  banner      String?
  country     String?
  sportId     String    @db.Uuid @map("sport_id")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  sport       Sport     @relation(fields: [sportId], references: [id], onDelete: Cascade)
  teams       SportTeam[]
  matches     Match[]

  @@index([sportId])
  @@index([isActive])
  @@map("tournaments")
}

model SportTeam {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  shortName   String?   @map("short_name")
  abbr        String?
  logo        String?
  country     String?
  primaryColor String?   @map("primary_color")
  secondaryColor String? @map("secondary_color")
  tournamentId String?   @db.Uuid @map("tournament_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tournament  Tournament?  @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  teamA       Match[]      @relation("TeamA")
  teamB       Match[]      @relation("TeamB")
  wins        Match[]      @relation("Winner")
  favorites   UserFavoriteTeam[]

  @@index([tournamentId])
  @@index([isActive])
  @@map("sport_teams")
}

model Match {
  id            String      @id @default(uuid()) @db.Uuid
  title         String?
  sportId       String      @db.Uuid @map("sport_id")
  tournamentId  String      @db.Uuid @map("tournament_id")
  teamAId       String      @db.Uuid @map("team_a_id")
  teamBId       String      @db.Uuid @map("team_b_id")
  scheduledAt   DateTime    @map("scheduled_at")
  status        MatchStatus @default(upcoming)
  venue         String?
  streamUrl     String?     @map("stream_url")
  liveUrl       String?     @map("live_url")
  teamAScore    String?     @map("team_a_score")
  teamBScore    String?     @map("team_b_score")
  winnerId      String?     @db.Uuid @map("winner_id")
  description   String?
  isActive      Boolean     @default(true) @map("is_active")
  viewCount     Int         @default(0) @map("view_count")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  sport         Sport       @relation(fields: [sportId], references: [id], onDelete: Cascade)
  tournament    Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA         SportTeam   @relation("TeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB         SportTeam   @relation("TeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  winner        SportTeam?  @relation("Winner", fields: [winnerId], references: [id], onDelete: SetNull)
  commentary    MatchCommentary[]
  alerts        MatchAlert[]

  @@index([sportId])
  @@index([tournamentId])
  @@index([status])
  @@index([scheduledAt])
  @@index([teamAId])
  @@index([teamBId])
  @@map("matches")
}

model MatchCommentary {
  id          String    @id @default(uuid()) @db.Uuid
  matchId     String    @db.Uuid @map("match_id")
  eventType   String    @default("general") @map("event_type")
  text        String
  score       String?
  over        String?
  minute      Int?
  timestamp   DateTime  @default(now()) @map("timestamp")
  createdAt   DateTime  @default(now()) @map("created_at")

  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, timestamp])
  @@map("match_commentary")
}

model MatchAlert {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid @map("user_id")
  matchId     String    @db.Uuid @map("match_id")
  isEnabled   Boolean   @default(true) @map("is_enabled")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
  @@map("match_alerts")
}

model UserFavoriteTeam {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid @map("user_id")
  teamId      String    @db.Uuid @map("team_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        SportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@map("user_favorite_teams")
}

// ─── Downloads Model ────────────────────────────────────────

model Download {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid @map("user_id")
  contentType String          @default("movie") @map("content_type")
  contentId   String          @map("content_id")
  title       String
  poster      String?
  streamUrl   String          @map("stream_url")
  quality     String          @default("720p")
  fileSize    Int             @default(0) @map("file_size")
  progress    Float           @default(0)
  status      DownloadStatus  @default(pending)
  filePath    String?         @map("file_path")
  expiresAt   DateTime?       @map("expires_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("downloads")
}

// ─── Ratings & Reviews Model ────────────────────────────────

model Review {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid @map("user_id")
  contentType String    @map("content_type")
  contentId   String    @map("content_id")
  rating      Int
  title       String?
  comment     String?
  isApproved  Boolean   @default(true) @map("is_approved")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentType, contentId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

// ─── M3U Import & Stream Validation ─────────────────────────────

model ImportJob {
  id                String           @id @default(uuid()) @db.Uuid
  filename          String
  filePath          String           @map("file_path")
  fileSize          Int              @map("file_size")
  status            ImportJobStatus  @default(pending)
  totalChannels     Int              @default(0) @map("total_channels")
  checkedChannels   Int              @default(0) @map("checked_channels")
  activeChannels    Int              @default(0) @map("active_channels")
  failedChannels    Int              @default(0) @map("failed_channels")
  skippedChannels   Int              @default(0) @map("skipped_channels")
  batchSize         Int              @default(50) @map("batch_size")
  saveFailed        Boolean          @default(false) @map("save_failed")
  startedAt         DateTime?        @map("started_at")
  completedAt       DateTime?        @map("completed_at")
  errorMessage      String?          @map("error_message")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  channels          ImportChannel[]

  @@index([status])
  @@index([createdAt])
  @@map("import_jobs")
}

model ImportChannel {
  id              String              @id @default(uuid()) @db.Uuid
  importJobId     String              @db.Uuid @map("import_job_id")
  channelName     String              @map("channel_name")
  streamUrl       String              @map("stream_url")
  logoUrl         String?             @map("logo_url")
  groupCategory   String?             @map("group_category")
  status          ImportChannelStatus @default(pending)
  failReason      String?             @map("fail_reason")
  httpStatus      Int?                @map("http_status")
  responseTimeMs  Int?                @map("response_time_ms")
  retryCount      Int                 @default(0) @map("retry_count")
  channelId       String?             @db.Uuid @map("channel_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  importJob       ImportJob           @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([status])
  @@index([channelName])
  @@map("import_channels")
}
