{
    "name": "@workspace/api-server",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "redis-server --daemonize yes --logfile /tmp/redis.log --port 6379 2>/dev/null || true; pnpm exec prisma generate; pnpm exec nest start --watch",
        "build": "pnpm exec prisma generate && pnpm exec nest build",
        "start": "node dist/main",
        "typecheck": "tsc --noEmit",
        "test": "jest --passWithNoTests --forceExit",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage --passWithNoTests --forceExit",
        "test:ci": "jest --passWithNoTests --forceExit --ci",
        "seed": "ts-node --transpile-only prisma/seed.ts",
        "migrate": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:generate": "prisma generate"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest",
                { "diagnostics": false }
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s",
            "!**/*.module.ts",
            "!**/main.ts"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "@prisma/client": "<rootDir>/__mocks__/@prisma/client.ts"
        }
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1068.0",
        "@aws-sdk/s3-request-presigner": "^3.502.0",
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^10.4.15",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.15",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.22",
        "@nestjs/platform-socket.io": "^10.4.15",
        "@nestjs/schedule": "^4.1.2",
        "@nestjs/swagger": "^8.1.1",
        "@nestjs/throttler": "^6.4.0",
        "@nestjs/websockets": "^10.4.15",
        "@prisma/client": "^6.9.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.78.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "compression": "^1.8.0",
        "helmet": "^8.0.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^9.0.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/schematics": "^10.2.3",
        "@nestjs/testing": "^10.4.15",
        "@types/bcryptjs": "^3.0.0",
        "@types/compression": "^1.7.5",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/multer": "^1.4.12",
        "@types/node": "catalog:",
        "@types/nodemailer": "^8.0.1",
        "@types/passport-jwt": "^4.0.1",
        "jest": "^30.4.2",
        "prisma": "^6.9.0",
        "ts-jest": "^29.4.0",
        "ts-loader": "^9.5.2",
        "typescript": "catalog:"
    }
}